# FemboyEngine2D - clangd project configuration.
#
# build-audit is the existing RelWithDebInfo database. Regenerate it with
#   cmake --preset audit-clang
# or point clangd at build-dev after configuring the dev-clang preset.
CompileFlags:
  CompilationDatabase: build-audit
  Add:
    - -std=c++26
Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict
