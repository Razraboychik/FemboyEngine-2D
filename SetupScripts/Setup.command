#!/bin/bash
# FemboyEngine 2.0 - one-click macOS dependency setup.
#
# Double-click in Finder or run:
#   ./Setup.command
#
# Installs Homebrew packages (CMake, Ninja, glslang, MoltenVK, p7zip) and the
# pinned sources (Monocypher 4.0.2 among them) into third_party/. Xcode Command
# Line Tools are required for clang++ and the Metal framework headers.
#
# HarfBuzz 15.0.0 and SheenBidi 3.0.0 ship inside third_party/ and are not
# downloaded here.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
THIRD="${ROOT}/third_party"
CACHE="${ROOT}/build/_deps-download"
FORCE=0
for arg in "$@"; do
    case "$arg" in
        --force) FORCE=1 ;;
        --skip-system) SKIP_SYSTEM=1 ;;
        --help|-h) sed -n '2,10p' "$0"; exit 0 ;;
    esac
done
mkdir -p "${THIRD}" "${CACHE}"
echo
echo "FemboyEngine 2.0 - macOS setup"
echo "repository: ${ROOT}"
echo

if ! xcode-select -p >/dev/null 2>&1; then
    echo "Xcode Command Line Tools are required. Installing..."
    xcode-select --install || true
    echo "Re-run Setup.command when the installer finishes."
    exit 1
fi

if ! command -v brew >/dev/null 2>&1; then
    echo "Homebrew is required: https://brew.sh"
    exit 1
fi

if [[ "${SKIP_SYSTEM:-0}" -eq 0 ]]; then
    echo "==> Homebrew packages"
    brew update
    # Xcode provides clang++; LLVM and GCC 15+ are installed as the pinned
    # second-opinion toolchains.
    brew install cmake ninja git p7zip glslang vulkan-headers vulkan-loader molten-vk llvm gcc
fi

if [[ -n "${VULKAN_SDK:-}" ]]; then
    echo "  VULKAN_SDK=${VULKAN_SDK}"
else
    echo "WARN: VULKAN_SDK is not set; MoltenVK is used for the Metal backend and Vulkan-Headers are local."
fi

download() {
    local url="$1" file="$2"
    local path="${CACHE}/${file}"
    if [[ -f "${path}" && "${FORCE}" -eq 0 ]]; then
        echo "  cached ${file}" >&2
    else
        echo "  downloading ${url}" >&2
        curl -fL --retry 3 -o "${path}" "${url}"
    fi
    shasum -a 256 "${path}" >> "${THIRD}/dependencies.lock"
    printf '%s\n' "${path}"
}

extract() {
    local archive="$1" destination="$2"
    mkdir -p "${destination}"
    tar --strip-components=1 -xzf "${archive}" -C "${destination}"
}

: > "${THIRD}/dependencies.lock"
printf '# FemboyEngine pinned dependencies - generated by Setup.command\n# version 1\ndate = %s\n' "$(date -Iseconds)" >> "${THIRD}/dependencies.lock"

echo
echo "==> SDL3 release-3.4.18"
extract "$(download "https://github.com/libsdl-org/SDL/archive/refs/tags/release-3.4.18.tar.gz" SDL3.tar.gz)" \
    "${THIRD}/sdl3-src"
echo "sdl3 = release-3.4.18" >> "${THIRD}/dependencies.lock"

echo "==> Vulkan-Headers v1.4.366"
extract "$(download "https://github.com/KhronosGroup/Vulkan-Headers/archive/refs/tags/v1.4.366.tar.gz" Vulkan-Headers.tar.gz)" \
    "${THIRD}/vulkan-headers-src"
echo "vulkan_headers = v1.4.366" >> "${THIRD}/dependencies.lock"

echo "==> glslang 15.3.0"
extract "$(download "https://github.com/KhronosGroup/glslang/archive/refs/tags/15.3.0.tar.gz" glslang.tar.gz)" \
    "${THIRD}/glslang-src"
echo "glslang = 15.3.0" >> "${THIRD}/dependencies.lock"

echo "==> miniaudio 0.11.23"
extract "$(download "https://github.com/mackron/miniaudio/archive/refs/tags/0.11.23.tar.gz" miniaudio.tar.gz)" \
    "${THIRD}/miniaudio-master/miniaudio-master"
echo "miniaudio = 0.11.23" >> "${THIRD}/dependencies.lock"

echo "==> Box2D v3.0.0"
extract "$(download "https://github.com/erincatto/box2d/archive/refs/tags/v3.0.0.tar.gz" box2d.tar.gz)" \
    "${THIRD}/box2d-main/box2d-main"
echo "box2d = v3.0.0" >> "${THIRD}/dependencies.lock"

echo "==> RNNoise 0.1.1"
rnnoise_archive="$(download "https://github.com/xiph/rnnoise/archive/refs/tags/v0.1.1.tar.gz" rnnoise.tar.gz)"
rm -rf "${CACHE}/rnnoise"
mkdir -p "${CACHE}/rnnoise" "${THIRD}/rnnoise"
tar -xzf "${rnnoise_archive}" -C "${CACHE}/rnnoise"
cp -r "${CACHE}/rnnoise/rnnoise-0.1.1/src" "${THIRD}/rnnoise/"
cp -r "${CACHE}/rnnoise/rnnoise-0.1.1/include" "${THIRD}/rnnoise/"
cp -f "${CACHE}/rnnoise/rnnoise-0.1.1/COPYING" "${THIRD}/rnnoise/"
echo "rnnoise = 0.1.1" >> "${THIRD}/dependencies.lock"

echo "==> Monocypher 4.0.2"
monocypher_archive="$(download "https://github.com/LoupVaillant/Monocypher/archive/refs/tags/4.0.2.tar.gz" monocypher.tar.gz)"
rm -rf "${CACHE}/monocypher"
mkdir -p "${CACHE}/monocypher" "${THIRD}/monocypher"
tar -xzf "${monocypher_archive}" -C "${CACHE}/monocypher"
cp -f "${CACHE}/monocypher/Monocypher-4.0.2/src/monocypher.h" "${THIRD}/monocypher/"
cp -f "${CACHE}/monocypher/Monocypher-4.0.2/src/monocypher.c" "${THIRD}/monocypher/"
cp -f "${CACHE}/monocypher/Monocypher-4.0.2/LICENCE.md" "${THIRD}/monocypher/"
echo "monocypher = 4.0.2" >> "${THIRD}/dependencies.lock"

echo "==> LZMA SDK 25.01"
if command -v 7z >/dev/null 2>&1; then
    archive="$(download "https://www.7-zip.org/a/lzma2501.7z" lzma.7z)"
    rm -rf "${CACHE}/lzma"
    mkdir -p "${CACHE}/lzma" "${THIRD}/lzma-sdk"
    7z x -y -o"${CACHE}/lzma" "${archive}" >/dev/null
    cp -f "${CACHE}/lzma/C/"* "${THIRD}/lzma-sdk/"
    echo "lzma_sdk = 25.01" >> "${THIRD}/dependencies.lock"
else
    echo "WARN: 7z is missing; FemArchiver will use the FbyLZ fallback."
fi

echo
echo "==> Mobile toolchains"
if [[ -n "${ANDROID_NDK_HOME:-}" || -n "${ANDROID_NDK_ROOT:-}" ]]; then
    echo "  Android: NDK at ${ANDROID_NDK_HOME:-${ANDROID_NDK_ROOT}}"
else
    echo "  Android: no NDK. Install Android Studio or set ANDROID_NDK_HOME to NDK r28c (28.2.13676358)"
fi
if command -v java >/dev/null 2>&1; then
    echo "  Android: JDK $(java -version 2>&1 | head -n 1)"
else
    echo "  Android: no JDK. Install OpenJDK 17 for the Gradle packaging step"
fi
if xcodebuild -version >/dev/null 2>&1; then
    echo "  iOS: $(xcodebuild -version | head -n 1)"
else
    echo "  iOS: Xcode 16 or newer is required for the iOS target"
fi

echo
echo "==> Done"
echo "  configure: cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo -DFBY_BUILD_TESTS=ON"
echo "  build    : cmake --build build"
echo "  test     : ctest --test-dir build --output-on-failure"
echo
echo "Press Return to close this window."
read -r _
