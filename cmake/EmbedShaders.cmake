# Embeds compiled SPIR-V modules into a generated C++ header.

if(NOT DEFINED OUTPUT OR NOT DEFINED SPEC)
    message(FATAL_ERROR "EmbedShaders.cmake requires OUTPUT and SPEC")
endif()
if(NOT DEFINED NAMESPACE)
    set(NAMESPACE "Fby::Rhi::Shaders")
endif()

set(content "// Generated by cmake/EmbedShaders.cmake - do not edit.\n")
string(APPEND content "#pragma once\n\n#include <array>\n#include <cstdint>\n\n")
string(APPEND content "namespace ${NAMESPACE}\n{\n\n")

string(REPLACE "|" ";" entries "${SPEC}")
foreach(entry IN LISTS entries)
    string(FIND "${entry}" "=" separator)
    if(separator EQUAL -1)
        message(FATAL_ERROR "Bad SPEC entry '${entry}'")
    endif()
    string(SUBSTRING "${entry}" 0 ${separator} symbol)
    math(EXPR valueStart "${separator} + 1")
    string(SUBSTRING "${entry}" ${valueStart} -1 input)

    if(NOT EXISTS "${input}")
        message(FATAL_ERROR "Shader blob not found: ${input}")
    endif()

    file(READ "${input}" hex HEX)
    string(LENGTH "${hex}" hexLength)
    math(EXPR wordCount "${hexLength} / 8")

# One substring per 32-bit word. The file is little-endian byte order, so
    set(words "")
    if(wordCount GREATER 0)
        math(EXPR lastWord "${wordCount} - 1")
        foreach(index RANGE ${lastWord})
            math(EXPR offset "${index} * 8")
            string(SUBSTRING "${hex}" ${offset} 8 group)
            string(SUBSTRING "${group}" 0 2 byte0)
            string(SUBSTRING "${group}" 2 2 byte1)
            string(SUBSTRING "${group}" 4 2 byte2)
            string(SUBSTRING "${group}" 6 2 byte3)
            string(APPEND words "0x${byte3}${byte2}${byte1}${byte0}, ")
        endforeach()
        string(REGEX REPLACE ", $" "" words "${words}")
    endif()

    string(APPEND content "inline constexpr std::array<std::uint32_t, ${wordCount}> ${symbol}{${words}};\n\n")
    message(STATUS "embedded ${symbol}: ${wordCount} words")
endforeach()

string(APPEND content "} // namespace ${NAMESPACE}\n")

file(WRITE "${OUTPUT}" "${content}")
