#version 460
// FemboyEngine 2.0 - procedural fire and smoke.
//
// Two noise fields in one pass: a fast simplex flame shape and a slow Worley smoke
// plume. The fire intensity comes from WeatherContextComponent, so a burning town
// and a lightning storm share one dispatch.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform WeatherBlock
{
    vec4 windAndTime;
    vec4 atmosphere;
    vec4 clouds;
    vec4 precipitation;
    vec4 fog;
    vec4 fieldTransform;
    vec4 fieldExtent;
    vec4 volume;
} weather;

layout(set = 0, binding = 1, rgba16f) uniform image2D uFire;

vec2 mod289(vec2 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec3 permute(vec3 x) { return mod(((x * 34.0) + 1.0) * x, 289.0); }

float simplex(vec2 v)
{
    const vec2 C = vec2(0.211324865, 0.366025404);
    const vec2 i = floor(v + dot(v, C.yy));
    const vec2 x0 = v - i + dot(i, C.xx);
    const vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
    const vec4 x12 = vec4(x0.xy, x0.xy) + vec4(C.xx, C.xx) - vec4(i1, 0.0, 0.0);
    const vec2 x1 = x12.xy - i1;
    const vec2 x2 = x12.zw;
    const vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0)) + i.x + vec3(0.0, i1.x, 1.0));
    const vec3 m = max(0.5 - vec3(dot(x0, x0), dot(x1, x1), dot(x2, x2)), 0.0);
    const vec3 px = 2.0 * fract(p * 0.0243902439) - 1.0;
    const vec3 py = 2.0 * fract(p * 0.0213243243) - 1.0;
    const vec3 a0 = x0.x * px + x0.y * py;
    const vec3 a1 = x1.x * px + x1.y * py;
    const vec3 a2 = x2.x * px + x2.y * py;
    return dot(m * m * m * m * (a0 + a1 + a2) * 0.5, vec3(1.0));
}

void main()
{
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(uFire);
    if (pixel.x >= size.x || pixel.y >= size.y)
    {
        return;
    }
    const vec2 uv = (vec2(pixel) + 0.5) / max(weather.fieldExtent.xy, vec2(1.0));
    const float time = weather.windAndTime.z;
    const vec2 wind = weather.windAndTime.xy * 0.0012;
    const float flameNoise = simplex(uv * vec2(9.0, 5.0) + vec2(wind.x * time, -time * 1.8));
    const float smokeNoise = simplex(uv * vec2(3.0, 2.2) + vec2(wind.x * time * 0.5, -time * 0.35) + 17.0);
    const float base = smoothstep(0.58, 0.12, uv.y);
    const float flame = smoothstep(0.35, 0.8, flameNoise * 0.5 + 0.5) * base * weather.precipitation.z;
    const float smoke = smoothstep(0.25, 0.9, smokeNoise * 0.5 + 0.5) * smoothstep(0.65, 0.0, uv.y) *
                        weather.precipitation.z * 0.6;
    const vec3 fireColor = mix(vec3(1.0, 0.22, 0.02), vec3(1.0, 0.82, 0.25), flame);
    const vec4 color = flame > smoke ? vec4(fireColor, flame) : vec4(vec3(0.18, 0.17, 0.17), smoke);
    imageStore(uFire, pixel, color);
}
