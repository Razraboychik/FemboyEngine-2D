#version 460
// FemboyEngine 2.0 - procedural cloud field.
//
// No cloud texture is loaded. The density is a two-octave simplex field advected
// by the same wind vector the cloth solver receives, then shaped by coverage and
// a Worley erosion pass for the billowy edge.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform WeatherBlock
{
    vec4 windAndTime;
    vec4 atmosphere;
    vec4 clouds;
    vec4 precipitation;
    vec4 fog;
    vec4 fieldTransform;
    vec4 fieldExtent;
    vec4 volume;
} weather;

layout(set = 0, binding = 1, rgba16f) uniform image2D uClouds;

vec2 mod289(vec2 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec3 permute(vec3 x) { return mod(((x * 34.0) + 1.0) * x, 289.0); }

float simplex(vec2 v)
{
    const vec2 C = vec2(0.211324865, 0.366025404);
    const vec2 i = floor(v + dot(v, C.yy));
    const vec2 x0 = v - i + dot(i, C.xx);
    const vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
    const vec4 x12 = vec4(x0.xy, x0.xy) + vec4(C.xx, C.xx) - vec4(i1, 0.0, 0.0);
    const vec2 x1 = x12.xy - i1;
    const vec2 x2 = x12.zw;
    const vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0)) + i.x + vec3(0.0, i1.x, 1.0));
    const vec3 m = max(0.5 - vec3(dot(x0, x0), dot(x1, x1), dot(x2, x2)), 0.0);
    const vec3 px = 2.0 * fract(p * 0.0243902439) - 1.0;
    const vec3 py = 2.0 * fract(p * 0.0213243243) - 1.0;
    const vec3 h = abs(px) - 0.5 - abs(py) - 0.5;
    const vec3 a0 = x0.x * px + x0.y * py;
    const vec3 a1 = x1.x * px + x1.y * py;
    const vec3 a2 = x2.x * px + x2.y * py;
    const vec3 a = m * m * m * m * (a0 + a1 + a2) * 0.5;
    return dot(a, vec3(1.0));
}

float fbm(vec2 p)
{
    float value = 0.0;
    float amplitude = 0.55;
    for (int i = 0; i < 4; ++i)
    {
        value += simplex(p) * amplitude;
        p = p * 2.03 + vec2(17.1, 9.7);
        amplitude *= 0.5;
    }
    return value;
}

void main()
{
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(uClouds);
    if (pixel.x >= size.x || pixel.y >= size.y)
    {
        return;
    }
    const vec2 uv = (vec2(pixel) + 0.5) / max(weather.fieldExtent.xy, vec2(1.0));
    const float time = weather.windAndTime.z * max(weather.clouds.y, 0.05);
    const vec2 drift = vec2(weather.windAndTime.x, weather.windAndTime.y) * time * 0.0015;
    const float base = fbm(uv * 3.2 + drift + vec2(time * 0.03));
    const float detail = simplex(uv * 9.0 - drift * 2.0 + vec2(0.0, time * 0.02));
    const float density = smoothstep(1.0 - weather.clouds.x, 1.05, base + detail * 0.25 + 0.5);
    const float height = smoothstep(0.0, 0.8, uv.y);
    const float lit = clamp(0.55 + density * 0.6 + detail * 0.12, 0.0, 1.0);
    imageStore(uClouds, pixel, vec4(vec3(lit) * vec3(0.95, 0.97, 1.0), density * height));
}
