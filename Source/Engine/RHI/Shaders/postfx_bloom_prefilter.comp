#version 460
// FemboyEngine 2.0 - bloom prefilter.
//
// A 16x16 tile is reduced to one bloom texel per invocation. The threshold is a
// soft knee so a bright sprite edge does not pop between mip levels.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D uScene;
layout(set = 0, binding = 1, rgba16f) uniform image2D uBloom;

layout(set = 0, binding = 2) uniform PostFxBlock
{
    vec4 flagsAndCrt;
    vec4 vignetteAndBloom;
    vec4 exposureAndChromatic;
    vec4 grainAndFlash;
} fx;

void main()
{
    const ivec2 size = imageSize(uBloom);
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= size.x || pixel.y >= size.y)
    {
        return;
    }
    const vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    const vec3 color = texture(uScene, uv).rgb * fx.vignetteAndBloom.w;
    const float threshold = fx.vignetteAndBloom.y;
    const float knee = max(threshold * 0.35, 0.0001);
    const float luminance = dot(color, vec3(0.2126, 0.7152, 0.0722));
    const float soft = clamp((luminance - threshold + knee) / (2.0 * knee), 0.0, 1.0);
    const float weight = max(luminance - threshold, 0.0) + soft * knee;
    imageStore(uBloom, pixel, vec4(color * (weight / max(luminance, 0.0001)), 1.0));
}
