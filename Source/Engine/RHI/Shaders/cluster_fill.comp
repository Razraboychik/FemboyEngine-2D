#version 460
// FemboyEngine2D - second clustered-light pass.
//
// A prefix sum has already written ClusterHeader::Offset. This pass appends the
// overlapping light indices and records any overflow beyond MaxPerCluster.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct GpuLight
{
    vec4 PositionAndRadius;
    vec4 ColorAndIntensity;
    vec4 DirectionAndCone;
    uint Type;
    uint Flags;
    uint ShadowIndex;
    uint Reserved;
};

struct ClusterHeader
{
    uint Offset;
    uint Count;
    uint OverflowCount;
    uint Flags;
};

layout(std430, set = 0, binding = 0) readonly buffer Lights
{
    GpuLight Items[];
} LightBuffer;

layout(std430, set = 0, binding = 1) buffer Headers
{
    ClusterHeader Items[];
} HeaderBuffer;

layout(std430, set = 0, binding = 2) writeonly buffer LightIndices
{
    uint Items[];
} IndexBuffer;

layout(push_constant) uniform ClusterConstants
{
    uvec2 Tiles;
    uint LightCount;
    uint MaxPerCluster;
} Constants;

void main()
{
    const uint Cluster = gl_GlobalInvocationID.x;
    const uint ClusterCount = Constants.Tiles.x * Constants.Tiles.y;
    if (Cluster >= ClusterCount)
    {
        return;
    }
    const uvec2 Tile = uvec2(Cluster % Constants.Tiles.x, Cluster / Constants.Tiles.x);
    const vec2 Min = vec2(Tile) * 16.0;
    const vec2 Max = Min + vec2(16.0);
    const uint Base = HeaderBuffer.Items[Cluster].Offset;
    uint Written = 0u;
    uint Overflow = 0u;
    for (uint Index = 0u; Index < Constants.LightCount; ++Index)
    {
        const GpuLight Light = LightBuffer.Items[Index];
        const vec2 Center = Light.PositionAndRadius.xy;
        const float Radius = Light.PositionAndRadius.z;
        const vec2 Closest = clamp(Center, Min, Max);
        if (distance(Closest, Center) > Radius)
        {
            continue;
        }
        if (Written < Constants.MaxPerCluster)
        {
            IndexBuffer.Items[Base + Written] = Index;
            ++Written;
        }
        else
        {
            ++Overflow;
        }
    }
    ClusterHeader Header;
    Header.Offset = Base;
    Header.Count = Written;
    Header.OverflowCount = Overflow;
    Header.Flags = 0u;
    HeaderBuffer.Items[Cluster] = Header;
}
